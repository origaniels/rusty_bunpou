import { LineEdit, Switch, ScrollView, ListView } from "std-widgets.slint";

// ------------------------------------------------------------------ data from Rust

export struct Glyph { x: length, y: length, w: length, text: string, ruby: string, ruby-x: length, ruby-w: length, cloze: bool }

export struct Frame { x: length, y: length, w: length, h: length }

export struct SentenceData {
    frames: [Frame],
    glyphs: [Glyph],
    cloze-x: length, cloze-y: length, cloze-w: length, cloze-h: length,
    height: length, ruby-h: length, main-h: length,
}

export struct Example { key: string, en: string }

export struct PointData {
    id: string, title: string, level: string, meaning: string, structure: string,
    explanation: string, status: string, can-reset: bool, examples: [Example],
}

/// a row of the grammar list: a level header (header != "", num = "learned / total") or a point
export struct ListItem { id: string, num: string, title: string, meaning: string, level: string, header: string, collapsed: bool }

export struct LevelRow { name: string, learned: int, total: int }

export struct PieSlice { path: string, fill: color }
export struct LevelPie { name: string, learned: int, total: int, slices: [PieSlice], counts: [int] }

export struct ChipRow { words: [string] }
export struct DayCell { level: int, label: string } // level -1 = after today (not drawn)
export struct ForecastBar { label: string, count: int }
export struct Leech { id: string, title: string, meaning: string, mistakes: string }

export struct QuizData {
    title: string, done: int, total: int, key: string, en: string, hint: string,
    verdict: int, // 0 = unanswered, 1 = correct, 2 = wrong
    last-answer: string, answer: string, grammar-line: string, attribution: string,
    finished: bool, summary: string, lesson: bool,
    reported: bool, // this sentence was already reported
    words: [string], // dictionary forms, shown as lookup chips after answering
}

export struct HomeData {
    due: int, new-count: int, learned: int, total: int, next-due: string, next-titles: string,
    learn-label: string, levels: [int], reviews-24h: int, source: string, level-rows: [LevelRow],
    start-level: string,
}

export global Logic {
    /// split words into rows of chips that fit `width` (Slint has no wrapping layout)
    pure callback chip-rows(words: [string], width: float, font: float) -> [ChipRow];
    /// mode: 0 = highlight, 1 = blank, 2 = revealed
    pure callback layout(key: string, mode: int, typed: string, furigana: bool, width: float, font: float) -> SentenceData;
}

export global Theme {
    out property <color> accent: #ff8a7a;
    out property <color> gold: #e0a100;
    out property <color> good: #3fbf72;
    out property <color> bad: #ef5a5a;
    out property <color> fg: #ecebf2;
    out property <color> muted: #9c9aa8;
    out property <color> card: #2b2a33;
    out property <color> bg: #141218;
}

// ------------------------------------------------------------------ building blocks

component SentenceView {
    in property <string> key;
    in property <int> mode;
    in property <string> typed;
    in property <bool> furigana: true;
    in property <length> font-size: 24px;
    in property <color> frame-color: mode == 2 ? Theme.good : Theme.accent;
    property <SentenceData> d: Logic.layout(key, mode, typed, furigana, root.width / 1px, font-size / 1px);
    min-height: d.height;
    preferred-height: d.height;

    // one frame per line: a long blank may wrap
    if mode == 0: Rectangle {
        for f in d.frames: Rectangle {
            x: f.x; y: f.y; width: f.w; height: f.h;
            background: Theme.gold.with-alpha(0.25);
            border-radius: 4px;
        }
    }
    for g in d.glyphs: Rectangle {
        x: g.x; y: g.y - d.ruby-h; width: g.w; height: d.ruby-h + d.main-h;
        if furigana && g.ruby != "": Text {
            // the reading may be wider than the character and overhang its neighbours
            x: g.ruby-x; y: 0; width: g.ruby-w; height: d.ruby-h;
            text: g.ruby; font-size: root.font-size * 0.45;
            color: (g.cloze && mode != 0 ? root.frame-color : Theme.fg).with-alpha(0.75);
            horizontal-alignment: center; vertical-alignment: bottom;
            overflow: clip; wrap: no-wrap;
        }
        Text {
            y: d.ruby-h; width: parent.width; height: d.main-h;
            text: g.text; font-size: root.font-size;
            color: g.cloze && mode != 0 ? root.frame-color : Theme.fg;
            font-weight: g.cloze ? 700 : 400;
            horizontal-alignment: center; vertical-alignment: center;
            wrap: no-wrap;
        }
    }
    if mode != 0: Rectangle {
        for f in d.frames: Rectangle {
            x: f.x; y: f.y; width: f.w; height: f.h;
            border-width: 2px; border-radius: 4px; border-color: root.frame-color;
        }
    }
    if mode == 1: Text {
        x: d.cloze-x; y: d.cloze-y; width: d.cloze-w; height: d.cloze-h;
        text: typed; font-size: root.font-size; color: Theme.accent;
        horizontal-alignment: center; vertical-alignment: center; wrap: no-wrap; overflow: elide;
    }
}

// a word to look up in the dictionary
component Chip inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 36px;
    width: label.preferred-width + 24px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #5c596c;
    background: ta.pressed ? #ffffff1c : transparent;
    label := Text { text: root.text; font-size: 16px; color: Theme.fg; }
    ta := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    min-height: 44px;
    preferred-height: 44px;
    min-width: label.preferred-width + 32px;
    preferred-width: label.preferred-width + 32px;
    border-radius: 12px;
    background: !enabled ? (primary ? #3a3846 : transparent)
        : primary ? (ta.pressed ? Theme.accent.darker(0.25) : Theme.accent)
        : (ta.pressed ? #ffffff1c : transparent);
    border-width: primary ? 0px : 1px;
    border-color: enabled ? #5c596c : #3e3b4a;
    label := Text {
        text: root.text; font-size: 15px; font-weight: 600;
        color: !root.enabled ? #77748a : root.primary ? #2a0f0b : Theme.fg;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
}

// line icon drawn from SVG path data (24×24 viewbox, stroked)
component Icon inherits Path {
    in property <string> d;
    width: 24px; height: 24px;
    viewbox-width: 24; viewbox-height: 24;
    commands: d;
    fill: transparent;
    stroke-width: 2px;
}

// compact "‹" back button
component BackBtn inherits Rectangle {
    callback clicked();
    width: 40px; height: 40px;
    border-radius: 10px;
    background: ta.pressed ? #ffffff1c : transparent;
    Icon { d: "M 15 5 L 8 12 L 15 19"; stroke: Theme.fg; x: 8px; y: 8px; }
    ta := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: @tr("‹ Back");
    accessible-action-default => { root.clicked(); }
}

// one row of mutually exclusive choices (3 / 5 / 10, N5 … N1, English / Français)
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    height: 40px;
    border-radius: 12px;
    background: Theme.card;
    HorizontalLayout {
        padding: 3px; spacing: 3px;
        for o[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            border-radius: 9px;
            background: i == root.selected ? Theme.accent : (t.pressed ? #ffffff14 : transparent);
            Text {
                text: o; font-size: 15px; font-weight: 600;
                color: i == root.selected ? #2a0f0b : Theme.fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            t := TouchArea { clicked => { root.picked(i); } }
            accessible-role: button;
            accessible-label: o;
            accessible-action-default => { root.picked(i); }
        }
    }
}

// bottom menu bar: Home / Grammar / Stats / Settings
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> name; // accessible label (kept stable for tests)
    in property <string> d;
    in property <bool> active;
    callback clicked();
    horizontal-stretch: 1;
    VerticalLayout {
        padding-top: 8px; padding-bottom: 8px; spacing: 4px; alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px; height: 30px; border-radius: 15px;
                background: root.active ? Theme.accent.with-alpha(0.22) : (ta.pressed ? #ffffff14 : transparent);
                Icon { d: root.d; stroke: root.active ? Theme.accent : Theme.muted; x: 16px; y: 3px; }
            }
        }
        Text {
            text: root.label; font-size: 12px; font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.fg : Theme.muted; horizontal-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }
}

component NavBar inherits Rectangle {
    in property <int> current; // screen id
    in property <length> inset; // bottom safe area (gesture bar)
    callback home();
    callback grammar();
    callback stats();
    callback settings();
    background: #1c1a22;
    Rectangle { y: 0; height: 1px; background: #2e2c36; }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; padding-bottom: root.inset;
        NavItem { label: @tr("Home"); name: @tr("Home"); active: root.current == 0; clicked => { root.home(); }
            d: "M 4 11 L 12 4 L 20 11 M 6 9.5 L 6 20 L 18 20 L 18 9.5 M 10 20 L 10 14 L 14 14 L 14 20"; }
        NavItem { label: @tr("Grammar"); name: @tr("Grammar list"); active: root.current == 3 || root.current == 4; clicked => { root.grammar(); }
            d: "M 5 4 L 15 4 L 19 8 L 19 20 L 5 20 Z M 8 10 L 16 10 M 8 13.5 L 16 13.5 M 8 17 L 13 17"; }
        NavItem { label: @tr("Stats"); name: @tr("Stats"); active: root.current == 6; clicked => { root.stats(); }
            d: "M 4 20 L 20 20 M 7 20 L 7 13 M 12 20 L 12 6 M 17 20 L 17 10"; }
        NavItem { label: @tr("Settings"); name: @tr("Settings"); active: root.current == 5; clicked => { root.settings(); }
            d: "M 4 7 L 20 7 M 4 17 L 20 17 M 9 4.5 L 9 9.5 M 15 14.5 L 15 19.5"; }
    }
}

component ToggleRow {
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.text; font-size: 17px; color: Theme.fg; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
        Switch { checked: root.checked; toggled => { root.toggled(self.checked); } }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <color> fill: #4a4658;
    background: fill;
    border-radius: self.height / 2;
    height: label.preferred-height + 12px;
    width: label.preferred-width + 24px;
    label := Text { text: root.text; color: Theme.fg; font-size: 15px; font-weight: 600; }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 18px;
}

component TopBar {
    in property <string> title;
    in property <bool> show-back: true;
    callback back();
    preferred-height: 56px;
    HorizontalLayout {
        padding-left: root.show-back ? 8px : 20px; padding-right: 16px; spacing: 6px;
        if show-back: VerticalLayout { alignment: center; BackBtn { clicked => { root.back(); } } }
        Text { text: root.title; font-size: 21px; font-weight: 600; color: Theme.fg; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

component ProgressBar inherits Rectangle {
    in property <float> progress;
    height: 6px;
    border-radius: 3px;
    background: #4a4658;
    Rectangle {
        x: 0; width: parent.width * clamp(root.progress, 0, 1);
        border-radius: 3px; background: Theme.accent;
    }
}

component GrammarBody {
    in property <PointData> p;
    in property <bool> furigana;
    in property <int> max-examples: 999;
    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px; alignment: start;
            Pill { text: p.level; y: (parent.height - self.height) / 2; }
            Text { text: p.title; font-size: 30px; font-weight: 700; color: Theme.fg; wrap: word-wrap; }
        }
        Text { text: p.meaning; font-size: 18px; color: Theme.accent; wrap: word-wrap; }
        Card {
            VerticalLayout {
                padding: 12px; spacing: 2px;
                Text { text: @tr("Structure"); font-size: 13px; color: Theme.muted; }
                Text { text: p.structure; font-size: 18px; color: Theme.fg; wrap: word-wrap; }
            }
        }
        Text { text: p.explanation; font-size: 17px; color: Theme.fg; wrap: word-wrap; }
        Rectangle { height: 1px; background: #4a4658; }
        Text { text: @tr("Examples"); font-size: 18px; font-weight: 600; color: Theme.fg; }
        for ex[i] in p.examples: VerticalLayout {
            spacing: 6px;
            padding-bottom: 8px;
            visible: i < root.max-examples;
            height: i < root.max-examples ? self.preferred-height : 0;
            SentenceView { key: ex.key; mode: 0; furigana: root.furigana; font-size: 20px; }
            Text { text: ex.en; font-size: 15px; color: Theme.muted; wrap: word-wrap; }
        }
    }
}

// a ScrollView whose content is a vertical column that fills the visible width
component Scroller inherits ScrollView {
    in property <length> pad: 20px;
    in property <length> spacing: 16px;
    content-width: self.visible-width;
    content-height: col.preferred-height;
    col := VerticalLayout {
        width: root.visible-width;
        padding-left: root.pad; padding-right: root.pad; padding-top: 8px; padding-bottom: 24px;
        spacing: root.spacing;
        @children
    }
}

// ------------------------------------------------------------------ main window

export component AppWindow inherits Window {
    title: "文法 SRS";
    background: Theme.bg;
    default-font-size: 16px;

    in-out property <int> screen; // 0 home, 1 lesson, 2 quiz, 3 list, 4 detail, 5 settings, 6 stats
    in property <[LevelPie]> level-pies;
    /// colors of the SRS stages New, Beginner ... Mastered (pie slices and legend)
    in property <[color]> stage-colors;
    in property <HomeData> home;
    in property <PointData> lesson-point;
    in property <int> lesson-index;
    in property <int> lesson-count;
    in property <QuizData> quiz;
    in-out property <string> quiz-input;   // raw text in the answer field
    in property <string> quiz-preview;     // kana preview shown in the blank
    in property <PointData> notes; // grammar notes inside quiz / detail page
    in-out property <bool> show-notes;
    in property <[ListItem]> grammar-list;
    in property <bool> furigana: true;
    in property <bool> english: true;
    in property <bool> romaji: true;
    in property <bool> notifications: true;
    in property <bool> haptics: true;
    in property <int> batch-size: 5;
    in property <int> retention-index: 1;
    in property <int> start-level-index: 0;
    in property <int> language-index: 0; // 0 English, 1 French
    in-out property <bool> confirm-reset;
    in-out property <bool> confirm-import;
    /// result of the last export / import, shown under the backup buttons
    in property <string> backup-status;
    /// sentence report dialog
    in-out property <bool> show-report;
    in-out property <int> report-reason: -1;
    in-out property <string> report-note;
    in property <string> report-sentence;
    in property <int> report-count;
    /// stats screen
    in property <string> streak-line;
    in property <[DayCell]> activity;
    in property <[ForecastBar]> forecast;
    in property <int> forecast-max: 1;
    in property <[Leech]> leeches;

    callback start-learn();
    callback lesson-prev();
    callback lesson-next();
    callback start-reviews();
    /// returns the text the field should show (only differs after the answer was checked)
    callback quiz-edited(string) -> string;
    callback quiz-submit();
    callback quiz-typo();
    callback quiz-retry();
    callback open-notes();
    callback go-home();
    callback go-back() -> bool;
    callback open-list();
    callback toggle-level(string);
    callback open-detail(string);
    callback open-settings();
    callback open-stats();
    callback set-furigana(bool);
    callback set-english(bool);
    callback set-romaji(bool);
    callback set-notifications(bool);
    callback set-haptics(bool);
    callback set-batch(int);
    callback set-retention(int);
    callback set-start-level(int);
    callback set-language(int);
    callback reset-point();
    callback reset-all();
    callback export-progress();
    callback import-progress();
    callback open-report();
    callback save-report(int, string);
    callback export-reports();
    callback lookup(string);

    /// Rust bumps this to move keyboard focus into the answer field.
    in property <int> focus-tick;

    property <bool> tab-screen: root.screen == 0 || root.screen == 3 || root.screen == 4 || root.screen == 5 || root.screen == 6;
    property <length> kb-height: self.virtual-keyboard-size.height > 0 ? max(0px, self.height - self.virtual-keyboard-position.y) : 0px;

    // the root scope owns keyboard focus outside the quiz so it receives the Android Back key
    forward-focus: scope;
    changed screen => { if (self.screen != 2) { scope.focus(); } }
    changed show-notes => { if (self.show-notes) { scope.focus(); } }
    changed show-report => { if (self.show-report) { scope.focus(); } }

    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Back) {
                if (root.show-notes) { root.show-notes = false; return accept; }
                if (root.confirm-reset) { root.confirm-reset = false; return accept; }
                if (root.confirm-import) { root.confirm-import = false; return accept; }
                if (root.show-report) { root.show-report = false; return accept; }
                return root.go-back() ? accept : reject;
            }
            reject
        }

        VerticalLayout {
            x: 0; y: 0; width: root.width; height: root.height;
            padding-top: root.safe-area-insets.top;
            // on tab screens the menu bar reaches the bottom edge and pads itself
            padding-bottom: root.tab-screen ? 0px : max(root.safe-area-insets.bottom, root.kb-height);
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;

            // ---------------------------------------------------------- home
            if root.screen == 0: Scroller {
                Text { text: "文法 SRS"; font-size: 24px; font-weight: 700; color: Theme.accent; }
                Text { text: @tr("Japanese grammar, one sentence at a time."); color: Theme.fg; }
                Card {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Text { text: @tr("Reviews"); font-size: 17px; color: Theme.fg; }
                        Text { text: @tr("{} due", root.home.due); font-size: 40px; font-weight: 700; color: Theme.fg; }
                        if root.home.due == 0 && root.home.next-due != "": Text { text: @tr("Next review {}", root.home.next-due); color: Theme.fg; }
                        Btn { text: @tr("Start reviews"); primary: true; enabled: root.home.due > 0; clicked => { root.start-reviews(); } }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Text { text: @tr("Learn"); font-size: 17px; color: Theme.fg; }
                        Text {
                            text: root.home.start-level == "N5"
                                ? @tr("{} new grammar points available", root.home.new-count)
                                : @tr("{} new grammar points from {} up", root.home.new-count, root.home.start-level);
                            color: Theme.fg; wrap: word-wrap;
                        }
                        if root.home.new-count == 0 && root.home.start-level != "N5": Text {
                            text: @tr("Lower levels can still be learned: choose a lower start level in Settings.");
                            font-size: 14px; color: Theme.muted; wrap: word-wrap;
                        }
                        if root.home.next-titles != "": Text { text: @tr("Next: {}", root.home.next-titles); font-size: 14px; color: Theme.muted; wrap: word-wrap; }
                        Btn { text: root.home.learn-label; primary: true; enabled: root.home.new-count > 0; clicked => { root.start-learn(); } }
                    }
                }
                Text { text: @tr("Example sentences: {}", root.home.source); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
            }

            // ---------------------------------------------------------- lesson
            if root.screen == 1: VerticalLayout {
                TopBar { title: @tr("Lesson {} / {}", root.lesson-index + 1, root.lesson-count); back => { root.go-back(); } }
                Scroller {
                    vertical-stretch: 1;
                    GrammarBody { p: root.lesson-point; furigana: root.furigana; max-examples: 4; }
                }
                HorizontalLayout {
                    padding: 16px; spacing: 12px;
                    Btn { text: @tr("Previous"); enabled: root.lesson-index > 0; clicked => { root.lesson-prev(); } }
                    Btn {
                        text: root.lesson-index < root.lesson-count - 1 ? @tr("Next") : @tr("Start quiz");
                        primary: true;
                        clicked => { root.lesson-next(); }
                    }
                }
            }

            // ---------------------------------------------------------- quiz
            if root.screen == 2 && root.quiz.finished: VerticalLayout {
                padding: 24px; spacing: 16px; alignment: start;
                Text { text: root.quiz.lesson ? @tr("Lesson complete!") : @tr("Reviews done!"); font-size: 30px; font-weight: 700; color: Theme.fg; }
                Text { text: root.quiz.summary; color: Theme.fg; }
                Btn { text: @tr("Home"); primary: true; clicked => { root.go-home(); } }
            }
            if root.screen == 2 && !root.quiz.finished: VerticalLayout {
                property <int> tick: root.focus-tick;
                changed tick => { answer.focus(); }
                init => { answer.focus(); }
                TopBar { title: root.quiz.title + "  " + root.quiz.done + " / " + root.quiz.total; back => { root.go-home(); } }
                HorizontalLayout { padding-left: 16px; padding-right: 16px; ProgressBar { progress: root.quiz.total > 0 ? root.quiz.done / root.quiz.total : 0; } }
                Scroller {
                    vertical-stretch: 1;
                    spacing: 14px;
                    SentenceView {
                        key: root.quiz.key;
                        mode: root.quiz.verdict == 0 ? 1 : 2;
                        typed: root.quiz-preview;
                        furigana: root.furigana;
                        font-size: 26px;
                        frame-color: root.quiz.verdict == 0 ? Theme.accent : root.quiz.verdict == 1 ? Theme.good : Theme.bad;
                    }
                    if root.english || root.quiz.verdict != 0: Text { text: root.quiz.en; font-size: 18px; color: Theme.muted; wrap: word-wrap; }
                    HorizontalLayout { alignment: start; Pill { text: root.quiz.hint; } }
                    if root.quiz.verdict != 0: VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: root.quiz.verdict == 1 ? @tr("Correct!") : @tr("Not quite. You wrote: {}", root.quiz.last-answer);
                            color: root.quiz.verdict == 1 ? Theme.good : Theme.bad;
                            font-size: 20px; font-weight: 700; wrap: word-wrap;
                        }
                        Text { text: @tr("Answer: {}", root.quiz.answer); font-size: 18px; color: Theme.fg; wrap: word-wrap; }
                        Text { text: root.quiz.grammar-line; color: Theme.fg; wrap: word-wrap; }
                        // two rows so long (French) labels never run off the screen
                        if root.quiz.verdict == 2: HorizontalLayout {
                            spacing: 8px;
                            Btn { text: @tr("Typo"); horizontal-stretch: 1; clicked => { root.quiz-typo(); } }
                            Btn { text: @tr("Retry"); horizontal-stretch: 1; clicked => { root.quiz-retry(); answer.focus(); } }
                        }
                        HorizontalLayout {
                            alignment: start; spacing: 8px;
                            Btn { text: @tr("Grammar notes"); clicked => { answer.clear-focus(); root.open-notes(); } }
                            Btn {
                                text: root.quiz.reported ? @tr("Reported") : @tr("Report");
                                enabled: !root.quiz.reported;
                                clicked => { answer.clear-focus(); root.open-report(); }
                            }
                        }
                        if root.quiz.words.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: @tr("Look up a word in Takoboto:"); font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                            // the scroller's content is the window width minus its padding
                            for row in Logic.chip-rows(root.quiz.words, (root.width - 48px) / 1px, 16): HorizontalLayout {
                                spacing: 8px; alignment: start;
                                for w in row.words: Chip { text: w; clicked => { answer.clear-focus(); root.lookup(w); } }
                            }
                        }
                        Text { text: root.quiz.attribution; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    padding: 16px; spacing: 8px;
                    answer := LineEdit {
                        text <=> root.quiz-input;
                        font-size: 22px;
                        // no suggestions/autocorrect: the keyboard must not "fix" romaji we convert to kana
                        input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
                        placeholder-text: root.romaji ? @tr("type in kana or romaji") : @tr("type the answer");
                        // The field keeps exactly what was typed (rewriting it would fight the keyboard's
                        // composition); the romaji→kana preview is shown inside the blank instead.
                        edited(t) => {
                            let n = root.quiz-edited(t);
                            if (n != t) { self.text = n; }
                        }
                        accepted(t) => { root.quiz-submit(); }
                    }
                    Btn {
                        text: root.quiz.verdict == 0 ? @tr("Check") : @tr("Next");
                        primary: true;
                        clicked => { root.quiz-submit(); }
                    }
                }
            }

            // ---------------------------------------------------------- grammar list
            if root.screen == 3: VerticalLayout {
                TopBar { title: @tr("Grammar"); show-back: false; }
                ListView {
                    vertical-stretch: 1;
                    for item in root.grammar-list: TouchArea {
                        height: col.preferred-height;
                        clicked => { if (item.header != "") { root.toggle-level(item.id); } else { root.open-detail(item.id); } }
                        accessible-role: list-item;
                        accessible-label: item.header != "" ? item.header : item.title;
                        accessible-action-default => { if (item.header != "") { root.toggle-level(item.id); } else { root.open-detail(item.id); } }
                        col := VerticalLayout {
                        // level header: tap to fold / unfold the level
                        if item.header != "": Rectangle {
                            height: 56px;
                            background: Theme.card;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 16px; spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    // chevron: down when open, right when folded
                                    Icon {
                                        d: item.collapsed ? "M 9 5 L 16 12 L 9 19" : "M 5 9 L 12 16 L 19 9";
                                        stroke: Theme.accent;
                                    }
                                }
                                Text { text: item.header; font-size: 17px; font-weight: 700; color: Theme.accent; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: item.num; font-size: 14px; color: Theme.muted; vertical-alignment: center; }
                            }
                        }
                        if item.header == "": HorizontalLayout {
                            padding: 12px; padding-left: 16px; spacing: 12px;
                            Text { text: item.num; width: 28px; color: Theme.muted; vertical-alignment: center; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: item.title; font-size: 20px; color: Theme.fg; wrap: word-wrap; } // long titles wrap instead of pushing the stage label off
                                Text { text: item.meaning; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                            }
                            Pill { text: item.level; y: (parent.height - self.height) / 2; }
                        }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: #3a3846; }
                    }
                }
            }

            // ---------------------------------------------------------- detail
            if root.screen == 4: VerticalLayout {
                TopBar { title: root.notes.title; back => { root.go-back(); } }
                Scroller {
                    vertical-stretch: 1;
                    Card {
                        HorizontalLayout {
                            padding: 12px; spacing: 8px;
                            Text { text: root.notes.status; color: Theme.fg; wrap: word-wrap; vertical-alignment: center; }
                            if root.notes.can-reset: Btn { text: @tr("Reset"); clicked => { root.confirm-reset = true; } }
                        }
                    }
                    GrammarBody { p: root.notes; furigana: root.furigana; }
                }
            }

            // ---------------------------------------------------------- stats
            if root.screen == 6: VerticalLayout {
                TopBar { title: @tr("Stats"); show-back: false; }
                Scroller {
                    vertical-stretch: 1;
                    // ------------------------------------------------ streak + activity calendar
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            property <string> tip;
                            Text { text: root.streak-line; font-size: 17px; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                            // 15 weeks, one column per week (Monday on top); squares sized to the width
                            cal := Rectangle {
                                property <length> gap: 3px;
                                property <length> cell: min(24px, (self.width - 14 * self.gap) / 15);
                                height: 7 * self.cell + 6 * self.gap;
                                for c[i] in root.activity: Rectangle {
                                    x: floor(i / 7) * (cal.cell + cal.gap);
                                    y: mod(i, 7) * (cal.cell + cal.gap);
                                    width: cal.cell; height: cal.cell;
                                    border-radius: 3px;
                                    visible: c.level >= 0;
                                    background: [#34323f, #1f4a7a, #2f74c8, #5d9de8, #a9cdf6][max(0, c.level)];
                                    TouchArea { clicked => { tip = c.label; } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: tip != "" ? tip : @tr("Tap a day to see its reviews.");
                                    font-size: 13px; color: tip != "" ? Theme.fg : Theme.muted; horizontal-stretch: 1;
                                    vertical-alignment: center; wrap: word-wrap;
                                }
                                Text { text: @tr("Less"); font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                for l in 5: Rectangle {
                                    width: 10px; height: 10px; y: (parent.height - self.height) / 2; border-radius: 2px;
                                    background: [#34323f, #1f4a7a, #2f74c8, #5d9de8, #a9cdf6][l];
                                }
                                Text { text: @tr("More"); font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                            }
                        }
                    }
                    // ------------------------------------------------ reviews forecast (7 days)
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            Text { text: @tr("Upcoming reviews"); font-size: 17px; font-weight: 600; color: Theme.fg; }
                            HorizontalLayout {
                                spacing: 6px; height: 120px;
                                for b in root.forecast: VerticalLayout {
                                    horizontal-stretch: 1; spacing: 4px; alignment: end;
                                    // only days with reviews get a number
                                    Text { text: b.count > 0 ? b.count : ""; font-size: 13px; font-weight: 600; color: Theme.fg; horizontal-alignment: center; }
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 16px;
                                            height: max(2px, 70px * b.count / root.forecast-max);
                                            border-radius: 4px;
                                            background: b.count > 0 ? #3987e5 : #34323f;
                                        }
                                    }
                                    Text { text: b.label; font-size: 12px; color: Theme.muted; horizontal-alignment: center; }
                                }
                            }
                        }
                    }
                    // ------------------------------------------------ leeches
                    if root.leeches.length > 0: Card {
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Text { text: @tr("Leeches"); font-size: 17px; font-weight: 600; color: Theme.fg; }
                            Text {
                                text: @tr("Points you got wrong 3 times in your last 5 reviews. Open one to read the notes again, or reset it to learn it again.");
                                font-size: 13px; color: Theme.muted; wrap: word-wrap;
                            }
                            for l in root.leeches: TouchArea {
                                height: lrow.preferred-height;
                                clicked => { root.open-detail(l.id); }
                                lrow := HorizontalLayout {
                                    padding-top: 8px; padding-bottom: 8px; spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        Text { text: l.title; font-size: 18px; color: Theme.fg; wrap: word-wrap; }
                                        Text { text: l.meaning; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                                    }
                                    Text { text: @tr("{} wrong", l.mistakes); font-size: 13px; color: Theme.bad; vertical-alignment: center; }
                                }
                                accessible-role: list-item;
                                accessible-label: l.title;
                                accessible-action-default => { root.open-detail(l.id); }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 14px;
                            Text { text: @tr("Progress: {} / {} learned", root.home.learned, root.home.total); font-size: 17px; font-weight: 600; color: Theme.fg; }
                            HorizontalLayout {
                                spacing: 4px;
                                for pie in root.level-pies: VerticalLayout {
                                    spacing: 6px;
                                    Text { text: pie.name; font-size: 15px; font-weight: 700; color: Theme.fg; horizontal-alignment: center; }
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 58px; height: 58px;
                                            for sl in pie.slices: Path {
                                                width: parent.width; height: parent.height;
                                                viewbox-width: 100; viewbox-height: 100;
                                                commands: sl.path;
                                                fill: sl.fill;
                                                stroke: Theme.card; stroke-width: 1.5px;
                                            }
                                        }
                                    }
                                    Text { text: pie.learned + " / " + pie.total; font-size: 12px; color: Theme.muted; horizontal-alignment: center; }
                                }
                            }
                            // legend (identity is never color-alone: every stage is named)
                            for row in [[0, 1, 2], [3, 4, 5]]: HorizontalLayout {
                                spacing: 8px;
                                for i in row: HorizontalLayout {
                                    // equal-width columns so both legend rows line up
                                    spacing: 6px; width: (parent.width - 16px) / 3;
                                    Rectangle { width: 12px; height: 12px; y: (parent.height - self.height) / 2; border-radius: 6px; background: root.stage-colors[i]; }
                                    Text { text: [@tr("New"), @tr("Beginner"), @tr("Adept"), @tr("Seasoned"), @tr("Expert"), @tr("Mastered")][i]; font-size: 13px; color: Theme.fg; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    // one section per level with the exact count for every SRS stage
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 14px;
                            Text { text: @tr("By level"); font-size: 17px; font-weight: 600; color: Theme.fg; }
                            for pie in root.level-pies: VerticalLayout {
                                spacing: 6px;
                                Text { text: "JLPT " + pie.name; font-size: 15px; font-weight: 700; color: Theme.accent; }
                                HorizontalLayout {
                                    for i in 6: VerticalLayout {
                                        horizontal-stretch: 1;
                                        // the color dot sits by the number so the stage name gets the whole column
                                        HorizontalLayout {
                                            alignment: center; spacing: 5px;
                                            Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: root.stage-colors[i]; }
                                            Text { text: pie.counts[i]; font-size: 18px; font-weight: 700; color: Theme.fg; }
                                        }
                                        Text { text: [@tr("New"), @tr("Beginner"), @tr("Adept"), @tr("Seasoned"), @tr("Expert"), @tr("Mastered")][i]; font-size: 11px; color: Theme.muted; horizontal-alignment: center; }
                                    }
                                }
                            }
                            Text { text: @tr("Reviews in the last 24 h: {}", root.home.reviews-24h); font-size: 13px; color: Theme.muted; }
                        }
                    }
                }
            }

            // ---------------------------------------------------------- settings
            if root.screen == 5: VerticalLayout {
                TopBar { title: @tr("Settings"); show-back: false; }
                Scroller {
                    vertical-stretch: 1;
                    Text { text: @tr("Language"); font-size: 17px; color: Theme.fg; }
                    // language names are never translated
                    Segmented { options: ["English", "Français"]; selected: root.language-index; picked(i) => { root.set-language(i); } }
                    ToggleRow { text: @tr("Furigana (readings above kanji)"); checked: root.furigana; toggled(v) => { root.set-furigana(v); } }
                    ToggleRow { text: @tr("Show the translation before answering"); checked: root.english; toggled(v) => { root.set-english(v); } }
                    ToggleRow { text: @tr("Convert romaji to kana"); checked: root.romaji; toggled(v) => { root.set-romaji(v); } }
                    ToggleRow { text: @tr("Remind me when reviews are due"); checked: root.notifications; toggled(v) => { root.set-notifications(v); } }
                    ToggleRow { text: @tr("Vibrate when an answer is checked"); checked: root.haptics; toggled(v) => { root.set-haptics(v); } }
                    Text { text: @tr("New points per lesson"); font-size: 17px; color: Theme.fg; }
                    Segmented {
                        options: ["3", "5", "10"];
                        selected: root.batch-size == 3 ? 0 : root.batch-size == 10 ? 2 : 1;
                        picked(i) => { root.set-batch([3, 5, 10][i]); }
                    }
                    Text { text: @tr("Start lessons at"); font-size: 17px; color: Theme.fg; }
                    Segmented { options: ["N5", "N4", "N3", "N2", "N1"]; selected: root.start-level-index; picked(i) => { root.set-start-level(i); } }
                    Text {
                        text: @tr("Lessons teach this level, then the ones above. Lower levels stay unlearned (not reviewed) until you pick them again.");
                        font-size: 13px; color: Theme.muted; wrap: word-wrap;
                    }
                    Text { text: @tr("Target retention (FSRS)"); font-size: 17px; color: Theme.fg; }
                    Segmented { options: ["85%", "90%", "95%"]; selected: root.retention-index; picked(i) => { root.set-retention(i); } }
                    Text { text: @tr("Higher retention = more frequent reviews. 90% is a good default."); font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                    Text { text: @tr("Backup"); font-size: 17px; color: Theme.fg; }
                    HorizontalLayout {
                        spacing: 8px;
                        Btn { text: @tr("Export progress"); horizontal-stretch: 1; clicked => { root.export-progress(); } }
                        Btn { text: @tr("Import progress"); horizontal-stretch: 1; clicked => { root.confirm-import = true; } }
                    }
                    Text {
                        text: root.backup-status != "" ? root.backup-status
                            : @tr("Your progress is only stored on this phone: export it now and then (Drive, email, …) to keep a copy.");
                        font-size: 13px; color: root.backup-status != "" ? Theme.fg : Theme.muted; wrap: word-wrap;
                    }
                    if root.report-count > 0: HorizontalLayout {
                        alignment: start;
                        Btn { text: @tr("Export reports ({})", root.report-count); clicked => { root.export-reports(); } }
                    }
                    HorizontalLayout { alignment: start; Btn { text: @tr("Reset all progress"); clicked => { root.confirm-reset = true; } } }
                    Text {
                        text: @tr("Most example sentences come from Tatoeba (tatoeba.org), licensed CC-BY 2.0 FR, and show their Tatoeba number and contributor. A few were written for this app and are marked as such.");
                        font-size: 13px; color: Theme.muted; wrap: word-wrap;
                    }
                }
            }
            if root.tab-screen: NavBar {
                current: root.screen;
                inset: root.safe-area-insets.bottom;
                height: 64px + root.safe-area-insets.bottom;
                home => { root.go-home(); }
                grammar => { root.open-list(); }
                stats => { root.open-stats(); }
                settings => { root.open-settings(); }
            }
        }

        // ---------------------------------------------------------- overlays
        if root.show-notes: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.show-notes = false; } }
            Rectangle {
                x: 16px; y: root.safe-area-insets.top + 40px;
                width: parent.width - 32px; height: parent.height - self.y - root.safe-area-insets.bottom - 40px;
                background: #1f1d25; border-radius: 20px;
                border-width: 1px; border-color: #3a3846;
                TouchArea { } // swallow clicks
                VerticalLayout {
                    padding-top: 12px;
                    Scroller { vertical-stretch: 1; GrammarBody { p: root.notes; furigana: root.furigana; max-examples: 3; } }
                    HorizontalLayout { padding: 12px; alignment: end; Btn { text: @tr("Close"); clicked => { root.show-notes = false; } } }
                }
            }
        }
        if root.confirm-reset: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.confirm-reset = false; } }
            Rectangle {
                x: 24px; width: parent.width - 48px; height: box.preferred-height; y: (parent.height - self.height) / 2;
                background: Theme.card; border-radius: 20px;
                TouchArea { }
                box := VerticalLayout {
                    padding: 20px; spacing: 16px;
                    Text {
                        text: root.screen == 4 ? @tr("Move \"{}\" back to unlearned?", root.notes.title) : @tr("Delete all SRS progress and review history?");
                        color: Theme.fg; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        Btn { text: @tr("Cancel"); clicked => { root.confirm-reset = false; } }
                        Btn {
                            text: @tr("Reset"); primary: true;
                            clicked => {
                                root.confirm-reset = false;
                                if (root.screen == 4) { root.reset-point(); } else { root.reset-all(); }
                            }
                        }
                    }
                }
            }
        }
        if root.confirm-import: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.confirm-import = false; } }
            Rectangle {
                x: 24px; width: parent.width - 48px; height: ibox.preferred-height; y: (parent.height - self.height) / 2;
                background: Theme.card; border-radius: 20px;
                TouchArea { }
                ibox := VerticalLayout {
                    padding: 20px; spacing: 16px;
                    Text {
                        text: @tr("Replace your progress with an exported file? Your current progress is kept on the phone as a backup copy.");
                        color: Theme.fg; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        Btn { text: @tr("Cancel"); clicked => { root.confirm-import = false; } }
                        Btn {
                            text: @tr("Choose a file"); primary: true;
                            clicked => { root.confirm-import = false; root.import-progress(); }
                        }
                    }
                }
            }
        }
        if root.show-report: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.show-report = false; } }
            Rectangle {
                // near the top, and moved up while the keyboard (for the note) is open so the
                // buttons stay above it
                x: 16px; width: parent.width - 32px; height: rbox.preferred-height;
                y: root.kb-height > 0 ? max(8px, min(48px, parent.height - root.kb-height - self.height - 8px)) : 48px;
                background: Theme.card; border-radius: 20px;
                TouchArea { }
                rbox := VerticalLayout {
                    padding: 20px; spacing: 10px;
                    Text { text: @tr("Report this sentence"); font-size: 20px; font-weight: 700; color: Theme.fg; wrap: word-wrap; }
                    Text { text: root.report-sentence; font-size: 16px; color: Theme.muted; wrap: word-wrap; }
                    for r[i] in [
                        @tr("It doesn't use this grammar point"),
                        @tr("The translation is wrong"),
                        @tr("The reading (furigana) is wrong"),
                        @tr("My answer should have been accepted"),
                        @tr("Something else"),
                    ]: Rectangle {
                        border-radius: 10px;
                        background: i == root.report-reason ? #ff8a7a26 : (rt.pressed ? #ffffff14 : transparent);
                        border-width: 1px;
                        border-color: i == root.report-reason ? Theme.accent : #3e3b4a;
                        HorizontalLayout {
                            padding: 10px; spacing: 10px;
                            Rectangle {
                                width: 18px; height: 18px; y: (parent.height - self.height) / 2;
                                border-radius: 9px; border-width: 2px;
                                border-color: i == root.report-reason ? Theme.accent : #77748a;
                                Rectangle {
                                    width: 8px; height: 8px; border-radius: 4px;
                                    background: i == root.report-reason ? Theme.accent : transparent;
                                }
                            }
                            Text { text: r; color: Theme.fg; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        rt := TouchArea { clicked => { root.report-reason = i; } }
                        accessible-role: button;
                        accessible-label: r;
                        accessible-action-default => { root.report-reason = i; }
                    }
                    LineEdit {
                        text <=> root.report-note;
                        font-size: 16px;
                        placeholder-text: @tr("Note (optional)");
                    }
                    if root.kb-height == 0: Text {
                        text: @tr("Reports stay on this phone. Export them from Settings to send them.");
                        font-size: 13px; color: Theme.muted; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        Btn { text: @tr("Cancel"); clicked => { root.show-report = false; } }
                        Btn {
                            text: @tr("Save report"); primary: true; enabled: root.report-reason >= 0;
                            clicked => { root.save-report(root.report-reason, root.report-note); }
                        }
                    }
                }
            }
        }
    }
}
